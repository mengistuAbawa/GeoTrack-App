{
  "expo": {
    "name": "GeoTrack",
    "slug": "geotrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "geotrack",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#173F91"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTabletMode": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GeoTrack needs access to your location to record your journey with your permission.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "GeoTrack needs background location access to continue recording journeys when the app is in the background.",
        "UIUserInterfaceStyle": "Light"
      },
      "bundleIdentifier": "com.geotrack.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#173F91"
      },
      "package": "com.geotrack.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow GeoTrack to access your location when you are using the app and when the app is in the background."
        }
      ],
      [
        "expo-task-manager",
        {
          "region": true
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-sqlite",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "geotrack-mobile"
      }
    }
  }
}
